# Copy to .env and adjust as needed: cp .env.example .env
# NEXT_PUBLIC_* values are inlined into the client bundle at build time.

# Customer shown on the dashboard (the mock API will serve this customer's data)
NEXT_PUBLIC_DEFAULT_CUSTOMER_ID=12345

# Server log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

MOCK_DATA_SEED=20240916

MOCK_API_LATENCY_MS=0
