# Copy to .env and adjust as needed: cp .env.example .env
# NEXT_PUBLIC_* values are inlined into the client bundle at build time.
# All values are validated on startup by lib/env.ts.

# Customer shown on the dashboard (the mock API serves this customer's data)
NEXT_PUBLIC_DEFAULT_CUSTOMER_ID=12345

# Server log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Seed for the mock data generator; the same seed always produces the same transactions
MOCK_DATA_SEED=20240916

# Artificial delay added to mock API responses, useful for checking loading states (0-10000)
MOCK_API_LATENCY_MS=0
